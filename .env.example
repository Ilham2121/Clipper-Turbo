# Copy to .env and adjust. All values have working defaults.

# Secret used to encrypt stored LLM API keys. Use a long random string.
CLIPPER_SECRET_KEY=dev-only-change-me

# On Linux, match the container user to your host user so bind-mounted
# ./storage stays writable (find yours with `id -u` and `id -g`).
# CLIPPER_UID=1000
# CLIPPER_GID=1000
